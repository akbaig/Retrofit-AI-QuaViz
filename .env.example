# Copy to .env and fill in. Never commit .env.

# LLM provider: gemini | ollama | template
LLM_PROVIDER=gemini

# Google Gemini (Vertex AI express mode — matches TS GoogleGenAI({ vertexai: true, apiKey }))
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_VERTEXAI=true

# Ollama (local). Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- app/backend (optional) ---
# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_TOPIC=retrofit/+/+/telemetry
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8000
# INFER_EVERY=5
# EXPLAIN=true
# EXPLAIN_WHAT_IF=false
# QUAVIZ_ASSETS=PUMP-08
# QUAVIZ_CHALLENGE_DIR=   # defaults to <repo>/retrofit_starter
# QUAVIZ_DATA_DIR=        # defaults to <challenge>/data/full

